---
const title = Astro.props.title ?? "Axiom Atelier";
const image = Astro.props.image ?? "/images/pieces/terra-framed.jpg";

const descriptions = {
  "Axiom Atelier":
    "Original earth and mineral pigment paintings by Jason Deters, made by one hand in High Point, North Carolina.",
  "Contact — Axiom Atelier":
    "Reach out to Axiom Atelier for inquiries about commissions, current pieces, or process questions.",
  "Collections — Axiom Atelier":
    "Explore Axiom Atelier's curated collections of handcrafted furniture, object pieces, and earth pigment paintings.",
  "Process — Axiom Atelier":
    "Learn how Axiom Atelier crafts each piece through disciplined subtraction, material study, and handwork.",
  "Manifesto — Axiom Atelier":
    "Read the Axiom Atelier manifesto on essential subtraction, material truth, and making with quiet intention."
};

const description = Astro.props.description ?? descriptions[title] ??
  "Handcrafted minimalist hardwood furniture and fine geological relief art.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-TMKY7LVNJK"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-TMKY7LVNJK');
</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{title}</title>

  <meta name="description" content={description} />

  <link rel="canonical" href={canonicalURL} />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />

  <!-- Twitter / Social Sharing -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site)} />
</head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <nav aria-label="Main navigation">
        <a href="/" class="logo">Axiom Atelier</a>
        <div class="links">
          <a href="/manifesto/">Manifesto</a>
          <a href="/available-works/">Available Works</a>
          <a href="/collections/">Collections</a>
          <a href="/artist/">Artist</a>
          <a href="/process/">Process</a>
          <a href="/contact/">Contact</a>
        </div>
        <details class="mobile-menu">
          <summary aria-label="Open site navigation">Explore <span aria-hidden="true">☰</span></summary>
          <div class="mobile-menu-links">
            <a href="/manifesto/">Manifesto</a>
            <a href="/available-works/">Available Works</a>
            <a href="/collections/">Collections</a>
            <a href="/artist/">Artist</a>
            <a href="/process/">Process</a>
            <a href="/contact/">Contact</a>
          </div>
        </details>
      </nav>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div><a class="footer-brand" href="/">Axiom Atelier</a><p>Earth. Mineral. One hand.</p><p>High Point, North Carolina</p></div>
      <div class="footer-links"><a href="/collections/">Collections &amp; objects</a><a href="/manifesto/">The manifesto</a><a href="https://latentformtheory.com">Latent Form Theory ↗</a><a href="mailto:jason@axiomatelier.com">jason@axiomatelier.com</a></div>
      <p class="copyright">&copy; {new Date().getFullYear()} Axiom Atelier · Jason Deters</p>
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:#f4f1e9; color:#29251f; font-family:Georgia,'Times New Roman',serif; -webkit-font-smoothing:antialiased; }
  a { color:inherit; text-decoration:none; }
  p { line-height:1.75; }
  h1,h2,h3 { font-weight:400; }
  img { max-width:100%; }
  .site-header { background:#20201d; color:#f4f1e9; padding:25px clamp(22px,4.5vw,72px); }
  .site-header nav { max-width:1600px; margin:auto; display:flex; justify-content:space-between; align-items:center; gap:30px; }
  .site-header .logo { font-size:clamp(17px,1.8vw,25px); text-transform:uppercase; letter-spacing:.24em; white-space:nowrap; }
  .site-header .links { display:flex; align-items:center; gap:clamp(14px,2vw,30px); font-size:clamp(12px,1.1vw,16px); letter-spacing:.045em; }
  .mobile-menu { display:none; }
  .site-header a { padding-block:5px; }
  .site-header .links a:hover { color:#d6b996; }
  body > main { max-width:1340px; margin:0 auto; padding:0 clamp(22px,4.5vw,64px); min-height:60vh; }
  .site-footer { max-width:1480px; margin:auto; border-top:1px solid #bfb6a7; padding:55px clamp(22px,4.5vw,72px) 25px; display:grid; grid-template-columns:1fr 1fr; gap:30px; color:#5f584e; }
  .footer-brand { font-size:22px; letter-spacing:.16em; text-transform:uppercase; color:#29251f; }
  .site-footer p { font-size:13px; margin:10px 0; }
  .footer-links { display:flex; flex-direction:column; align-items:flex-end; gap:15px; font-size:14px; }
  .copyright { grid-column:1/-1; border-top:1px solid #d4ccbf; padding-top:22px; }
  :focus-visible { outline:2px solid #9d7445; outline-offset:5px; }
  .skip-link { position:absolute; left:20px; top:-100px; z-index:99; padding:12px; background:#f4f1e9; color:#20201d; }
  .skip-link:focus { top:10px; }
  @media(max-width:950px) {
    .site-header { padding:20px 22px; }
    .site-header nav { flex-wrap:wrap; gap:12px; }
    .site-header .links { display:none; }
    .mobile-menu { display:block; margin-left:auto; position:relative; font-size:14px; }
    .mobile-menu summary { cursor:pointer; list-style:none; padding:10px 0 10px 14px; letter-spacing:.08em; }
    .mobile-menu summary::-webkit-details-marker { display:none; }
    .mobile-menu summary span { margin-left:12px; }
    .mobile-menu-links { position:absolute; right:-22px; top:calc(100% + 20px); z-index:50; width:min(320px,90vw); background:#20201d; border-top:1px solid #6b655b; box-shadow:0 14px 25px #0003; padding:12px 25px 25px; display:flex; flex-direction:column; }
    .mobile-menu-links a { padding:13px 0; border-bottom:1px solid #ffffff24; }
    .site-footer { grid-template-columns:1fr; }
    .footer-links { align-items:flex-start; }
  }
  @media(max-width:390px) { .site-header .logo { font-size:16px; letter-spacing:.13em; } }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition:none!important; } }
</style>
