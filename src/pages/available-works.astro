---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { artworks, priceLabel } from '../data/artworks';
const shareImage = await getImage({src:artworks[0].cover,width:1200,format:'webp'});
---
<BaseLayout title="Available Works — Axiom Atelier" description="Original earth and mineral pigment paintings by Jason Deters. Explore available works, dimensions and prices, and arrange purchase directly with the artist." image={shareImage.src}>
  <div class="gallery-page">
    <header class="intro">
      <p class="eyebrow">Original paintings · Jason Deters</p>
      <h1>Available Works</h1>
      <p class="intro-copy">Earth, mineral, and the evidence of one hand.<br />Explore each painting, then arrange its place in your collection.</p>
    </header>
    <div class="gallery-caption"><span>From the studio in High Point, North Carolina</span><span>Prices in USD</span></div>
    <section class="wall" aria-label="Original paintings">
      {artworks.map((work, index) => (
        <article>
          <a class="picture" href={`/works/${work.slug}/`} aria-label={`View ${work.title}, dimensions and purchase details`}>
            <Image src={work.cover} widths={[640,1200]} sizes="(max-width: 700px) 100vw, 50vw" width={1200} format="webp" quality={86} alt={`${work.title}, framed original painting by Jason Deters`} loading={index === 0 ? 'eager' : 'lazy'} />
            <span class="view">View the work ↗</span>
          </a>
          <div class="card-heading"><h2><a href={`/works/${work.slug}/`}>{work.title}</a></h2><p class="price">{priceLabel(work.price)}</p></div>
          <p class="dimensions">{work.height}″ H × {work.width}″ W · Painting dimensions</p>
          <p class="medium">{work.materials}</p>
          <div class="card-footer"><span>{work.status === 'available' ? 'Available' : 'Sold'}</span><a href={`/works/${work.slug}/`}>Details &amp; acquisition <span aria-hidden="true">→</span></a></div>
        </article>
      ))}
    </section>
    <section class="note">
      <h2>A direct connection to the maker.</h2>
      <p>Each original is made solely by Jason Deters and accompanied by a certificate of authenticity. For large works, delivery is arranged individually before payment. Applicable tax and delivery are additional.</p>
      <a href="mailto:jason@axiomatelier.com?subject=Designer%20and%20trade%20inquiry">Designer &amp; trade inquiries →</a>
    </section>
  </div>
</BaseLayout>
<style>
  :global(body) { background: #f4f1e9; }
  :global(main) { max-width: 1340px; padding: 0 clamp(20px,4vw,64px); }
  .gallery-page { color:#24241f; }
  .intro { padding:clamp(30px,4vw,55px) 0 30px; }
  .eyebrow,.gallery-caption,.dimensions,.medium,.card-footer,.price,.view { font-family:Arial,sans-serif; }
  .eyebrow { font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:#696457; }
  h1 { font-size:clamp(42px,6vw,72px); font-weight:400; letter-spacing:-.045em; margin:16px 0; }
  .intro-copy { font-size:clamp(18px,2vw,22px); line-height:1.6; color:#5c584e; }
  .gallery-caption { display:flex; justify-content:space-between; gap:20px; border-top:1px solid #cdc6b9; padding:20px 0 28px; font-size:11px; color:#6d665a; }
  .wall { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:60px 44px; }
  .picture { position:relative; display:flex; align-items:center; justify-content:center; background:#e9e4d9; aspect-ratio:4/5; max-height:580px; padding:22px; overflow:hidden; }
  .picture img { width:100%; height:100%; object-fit:contain; transition:transform .3s ease; }
  .picture:hover img { transform:scale(1.015); }
  .view { position:absolute; bottom:15px; right:15px; background:#faf9f6; padding:10px 13px; font-size:11px; }
  a { color:inherit; text-decoration:none; }
  .card-heading { display:flex; gap:12px; justify-content:space-between; align-items:baseline; margin-top:23px; }
  h2 { font-weight:400; font-size:clamp(23px,2.5vw,32px); margin:0; }
  .price { font-size:16px; white-space:nowrap; margin:0; }
  .dimensions { font-size:12px; color:#696457; line-height:1.6; margin:12px 0 5px; }
  .medium { font-size:12px; color:#696457; line-height:1.6; margin:0 0 20px; }
  .card-footer { display:flex; justify-content:space-between; gap:12px; border-top:1px solid #cdc6b9; padding-top:17px; font-size:12px; }
  .card-footer a { text-decoration:underline; text-underline-offset:5px; }
  .note { border-top:1px solid #cdc6b9; margin-top:80px; padding:45px 0 70px; }
  .note p { max-width:640px; color:#5c584e; line-height:1.7; font-size:17px; }
  .note a { display:inline-block; margin-top:12px; border-bottom:1px solid; padding-bottom:4px; }
  :focus-visible { outline:2px solid #755735; outline-offset:5px; }
  @media(max-width:700px) { .wall { grid-template-columns:1fr; gap:45px; } .gallery-caption { font-size:10px; } .picture { padding:16px; } .note { margin-top:50px; } }
  @media(prefers-reduced-motion:reduce) { .picture img { transition:none; } }
</style>
