---
import BaseLayout from "../layouts/BaseLayout.astro";

const paintings = [
  {
    title: "Terra — A Study in Latent Form",
    image: "/images/pieces/terra-framed.jpg",
    alt: "Terra, an earth-pigment painting by Jason Deters",
    dimensions: "40 × 60 in.",
    materials: "Earth and mineral pigments, modeling medium, and raw linen",
    description:
      "Order gathers, fractures, and disperses across a field of raw linen. Terra allows neither geometry nor entropy to prevail; each becomes legible through the presence of the other.",
  },
  {
    title: "Tectonic Restraint",
    image: "/images/pieces/tectonic-restraint-framed.jpg",
    alt: "Tectonic Restraint, a material painting by Jason Deters",
    dimensions: "36 × 48 in.",
    materials: "Earth and mineral pigments, textile, carbon, and mixed media",
    description:
      "A compressed material field is interrupted by a single displaced fissure—an examination of pressure, fracture, and the discipline required to hold opposing forces in suspension.",
  },
];

const objects = [
  {
    title: "Still Horizon",
    image: "/images/pieces/still-horizon.jpeg",
    type: "Side table",
    description:
      "Quarter-sawn white oak shaped around a single horizontal plane—quiet, architectural, and made one at a time.",
  },
  {
    title: "Tranquil Ember",
    image: "/images/pieces/tranquil-ember-5.jpg",
    type: "Votive object",
    description:
      "A restrained composition of quarter-sawn white oak, Peruvian walnut, and gathered light.",
  },
];
---

<BaseLayout title="Collections — Axiom Atelier">
  <header class="collections-hero">
    <p class="eyebrow">Selected works</p>
    <h1>Material reveals what composition cannot impose.</h1>
    <p class="hero-copy">
      Axiom Atelier is a material-led art and design practice founded by Jason Deters.
      Original paintings form the primary body of work, joined by collectible objects
      and limited-edition lighting governed by the same philosophy of making.
    </p>
  </header>

  <main>
    <section class="collection paintings" aria-labelledby="paintings-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Primary body of work</p>
          <h2 id="paintings-heading">Original Works</h2>
        </div>
        <p>
          Earth, mineral pigment, textile, and carbon are accumulated, displaced, and
          reduced until an inherent order becomes visible. Each work is singular and
          completed by one hand.
        </p>
      </div>

      <div class="painting-grid">
        {paintings.map((piece, index) => (
          <article class:list={["artwork", index === 0 && "artwork-featured"]}>
            <button
              class="artwork-image"
              type="button"
              data-lightbox-src={piece.image}
              data-lightbox-alt={piece.alt}
              aria-label={`View ${piece.title} larger`}
            >
              <img src={piece.image} alt={piece.alt} loading={index === 0 ? "eager" : "lazy"} />
            </button>
            <div class="artwork-copy">
              <p class="work-number">0{index + 1}</p>
              <h3>{piece.title}</h3>
              <p class="work-details">{piece.dimensions}<br />{piece.materials}</p>
              <p>{piece.description}</p>
              <a href="/contact" class="text-link">Inquire about this work</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="collection in-progress" aria-labelledby="progress-heading">
      <div class="progress-image">
        <button
          class="artwork-image"
          type="button"
          data-lightbox-src="/images/pieces/work-in-progress.jpeg"
          data-lightbox-alt="An original Axiom Atelier painting in progress"
          aria-label="View the work in progress larger"
        >
          <img
            src="/images/pieces/work-in-progress.jpeg"
            alt="An original Axiom Atelier painting in progress"
            loading="lazy"
          />
        </button>
      </div>
      <div class="progress-copy">
        <p class="eyebrow">From the studio</p>
        <h2 id="progress-heading">A body of work in formation</h2>
        <p>
          The inaugural collection continues to develop through an ongoing investigation
          of order, material intelligence, and entropic change. This image documents a
          work in progress; the final composition will be determined through the material
          process rather than imposed in advance.
        </p>
        <p class="status">Work in progress · Final work forthcoming</p>
      </div>
    </section>

    <section class="collection objects" aria-labelledby="objects-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The practice in three dimensions</p>
          <h2 id="objects-heading">Collectible Objects</h2>
        </div>
        <p>
          Furniture and objects extend Latent Form Theory into function, proportion, and
          light. Produced individually in natural materials, each retains the evidence of
          its making.
        </p>
      </div>

      <div class="object-grid">
        {objects.map((piece) => (
          <article class="object">
            <button
              class="object-image"
              type="button"
              data-lightbox-src={piece.image}
              data-lightbox-alt={`${piece.title} by Axiom Atelier`}
              aria-label={`View ${piece.title} larger`}
            >
              <img src={piece.image} alt={`${piece.title} by Axiom Atelier`} loading="lazy" />
            </button>
            <p class="object-type">{piece.type}</p>
            <h3>{piece.title}</h3>
            <p>{piece.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="collection closing">
      <p class="eyebrow">Acquisitions, trade, and commissions</p>
      <h2>For spaces shaped with intention.</h2>
      <p>
        Original works and collectible objects are available to collectors, interior
        designers, and select hospitality projects. A limited number of commissions are
        accepted when the material and setting invite a meaningful response.
      </p>
      <a href="/contact" class="button primary">Begin an inquiry</a>
    </section>
  </main>

  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Expanded artwork" aria-hidden="true">
    <button id="lightbox-close" class="lightbox-close" type="button" aria-label="Close expanded image">&times;</button>
    <img id="lightbox-img" src="" alt="" />
  </div>
</BaseLayout>

<style>
  :global(body) { background: #f4f1e9; }
  .collections-hero, .collection { max-width: 1180px; margin-inline: auto; }
  .collections-hero { padding: clamp(6rem, 12vw, 10rem) 0 clamp(5rem, 9vw, 8rem); }
  .eyebrow, .work-number, .object-type, .status {
    color: #756f64; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase;
  }
  .collections-hero h1 { max-width: 940px; margin: .7rem 0 2rem; font-size: clamp(3rem, 7vw, 6.8rem); line-height: .96; font-weight: 400; letter-spacing: -.04em; }
  .hero-copy { max-width: 720px; margin-left: auto; font-size: clamp(1.05rem, 1.6vw, 1.3rem); line-height: 1.7; }
  .collection { padding: clamp(5rem, 9vw, 9rem) 0; border-top: 1px solid #cfc9bd; }
  .section-heading { display: grid; grid-template-columns: minmax(0, .9fr) minmax(320px, .7fr); gap: 4rem; align-items: end; margin-bottom: 5rem; }
  h2 { margin: .55rem 0 0; font-size: clamp(2.6rem, 5vw, 5rem); line-height: 1; font-weight: 400; letter-spacing: -.035em; }
  h3 { margin: .5rem 0 1rem; font-size: clamp(1.5rem, 2.2vw, 2.35rem); font-weight: 400; }
  p { line-height: 1.72; }
  .painting-grid { display: grid; gap: clamp(6rem, 12vw, 12rem); }
  .artwork { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(280px, .6fr); gap: clamp(2.5rem, 6vw, 7rem); align-items: end; }
  .artwork:nth-child(even) { grid-template-columns: minmax(280px, .6fr) minmax(0, 1.4fr); }
  .artwork:nth-child(even) .artwork-image { order: 2; }
  .artwork:nth-child(odd) .artwork-image img {
  object-position: right bottom;
}
  .artwork-image, .object-image { display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  .artwork-image img { display: block; width: 100%; max-height: 78vh; object-fit: contain; object-position: left bottom; }
  .artwork-copy { padding-bottom: 1rem; }
  .work-details { color: #5f5a51; font-size: .9rem; line-height: 1.6; }
  .text-link { display: inline-block; margin-top: 1rem; padding-bottom: .2rem; border-bottom: 1px solid currentColor; color: inherit; text-decoration: none; }
  .in-progress { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr); gap: clamp(3rem, 8vw, 8rem); align-items: center; }
  .progress-image img { filter: saturate(.88); }
  .progress-copy h2 { margin-bottom: 2rem; }
  .status { margin-top: 2rem; }
  .object-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 5vw, 5rem); }
  .object-image { aspect-ratio: 4 / 3; overflow: hidden; margin-bottom: 1.8rem; }
  .object-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .object-image:hover img { transform: scale(1.025); }
  .object h3 { margin-top: .35rem; }
  .object p:last-child { max-width: 500px; }
  .closing { max-width: 800px; margin-left: max(0px, calc((100vw - 1180px) / 2)); border-top: 0; }
  .closing h2 { margin-bottom: 2rem; }
  .button.primary { display: inline-block; margin-top: 2rem; padding: 1rem 1.8rem; border: 1px solid #171715; background: #171715; color: #f7f4ec; text-decoration: none; }
  .lightbox { display: none; position: fixed; inset: 0; z-index: 1000; padding: 4rem; background: rgba(15, 15, 14, .96); align-items: center; justify-content: center; }
  .lightbox.active { display: flex; }
  .lightbox img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .lightbox-close { position: absolute; top: 1rem; right: 1.4rem; border: 0; background: transparent; color: white; font-size: 2.5rem; cursor: pointer; }
  @media (max-width: 760px) {
    .collections-hero, .collection { padding-left: 1.25rem; padding-right: 1.25rem; }
    .section-heading, .artwork, .artwork:nth-child(even), .in-progress { grid-template-columns: 1fr; gap: 2.5rem; }
    .artwork:nth-child(even) .artwork-image { order: initial; }
    .section-heading { margin-bottom: 3rem; }
    .object-grid { grid-template-columns: 1fr; }
    .lightbox { padding: 3.5rem 1rem 1rem; }
  }
</style>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const closeBtn = document.getElementById("lightbox-close");
  let lastTrigger: HTMLElement | null = null;

  document.querySelectorAll<HTMLElement>("[data-lightbox-src]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      lastTrigger = trigger;
      lightboxImg.src = trigger.dataset.lightboxSrc ?? "";
      lightboxImg.alt = trigger.dataset.lightboxAlt ?? "Expanded artwork";
      lightbox?.classList.add("active");
      lightbox?.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    });
  });

  function closeLightbox() {
    lightbox?.classList.remove("active");
    lightbox?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    lastTrigger?.focus();
  }

  closeBtn?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox?.classList.contains("active")) closeLightbox();
  });
</script>
